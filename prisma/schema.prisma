// SQLite database stored at ./prisma/dev.db — no database server required.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

/// App-wide key/value settings. Currently unused; kept so existing databases (which may hold a
/// row from the removed PIN feature) migrate without a destructive table drop.
model AppSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

/// One linked WhatsApp account. `id` is the UUID generated by the browser.
model UserSession {
  id          String   @id @default(uuid())
  phoneNumber String?
  name        String?
  /// INITIALIZING | CONNECTED | LOGGED_OUT
  status      String   @default("INITIALIZING")
  /// Last time the address book was pulled from WhatsApp. Reconnects skip the pull while this is recent.
  contactsSyncedAt DateTime?
  /// Set on the first successful connection. Chat history is only accepted before that (WhatsApp sends it once, right after linking).
  historyCheckedAt  DateTime?
  /// When chat-history metadata (not message text) was last imported
  historyImportedAt DateTime?
  /// When smart groups were last computed
  categorizedAt     DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  contacts  Contact[]
  groups    ContactGroup[]
  campaigns BroadcastCampaign[]
  draft     Draft?
  activity  ChatActivity[]
}

model Contact {
  id        String   @id @default(uuid())
  sessionId String
  /// e.g. 919876543210@s.whatsapp.net
  jid       String
  /// Address-book name (from your phone's contacts)
  name      String?
  /// WhatsApp profile ("push") name, used as a fallback
  pushName  String?
  /// E.164 phone, e.g. +919876543210
  phone     String
  /// WhatsApp privacy id (…@lid); some chats are addressed by this instead of the phone number
  lid       String?
  /// Smart category from the last categorisation: frequent | chatted | cold
  chatCategory String?
  /// Most recent message either way, from chat activity (no message content is stored)
  lastChatAt   DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  session UserSession    @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  groups  ContactGroup[]

  @@unique([sessionId, jid])
  @@index([sessionId])
  @@index([sessionId, lid])
}

/// Per-chat engagement counters used for smart groups. Only counts and timestamps — never message text.
model ChatActivity {
  id            String    @id @default(uuid())
  sessionId     String
  /// The chat's id as WhatsApp reports it: phone JID (…@s.whatsapp.net) or privacy id (…@lid)
  jid           String
  messagesIn    Int       @default(0)
  messagesOut   Int       @default(0)
  lastInAt      DateTime?
  lastOutAt     DateTime?
  /// The chat exists in the WhatsApp chat list (even if no messages were imported)
  hasThread     Boolean   @default(false)
  /// Chat-list timestamp of the last activity
  threadAt      DateTime?
  updatedAt     DateTime  @updatedAt

  session UserSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@unique([sessionId, jid])
}

model ContactGroup {
  id        String   @id @default(uuid())
  name       String
  sessionId  String
  /// When true, contacts that appear in the address book later are added to this group automatically.
  autoAddNew Boolean  @default(false)
  /// Smart group managed by the categoriser: frequent | chatted | cold (membership is replaced on each run)
  smartKey   String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  session   UserSession         @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  contacts  Contact[]
  campaigns BroadcastCampaign[]

  @@unique([sessionId, name])
}

model BroadcastCampaign {
  id              String    @id @default(uuid())
  sessionId       String
  groupId         String?
  name            String
  messageTemplate String
  /// Relative path inside ./uploads
  mediaPath       String?
  /// image | video
  mediaType       String?
  /// Compressed attachment size in bytes, and video length in seconds
  mediaSize       Int?
  mediaDuration   Float?
  /// SCHEDULED | PROCESSING | PAUSED | QUIET_HOURS_PAUSED | COMPLETED | ABORTED
  status          String    @default("PROCESSING")
  /// When a SCHEDULED campaign should start (null = started immediately)
  scheduledAt     DateTime?
  totalRecipients Int
  sentCount       Int       @default(0)
  failedCount     Int       @default(0)
  /// From WhatsApp receipts: reached the phone / opened (read only if the recipient shares read receipts)
  deliveredCount  Int       @default(0)
  readCount       Int       @default(0)
  /// First and latest dispatch, used for the real average gap between messages (ETA)
  startedAt       DateTime?
  lastDispatchAt  DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  completedAt     DateTime?

  session UserSession   @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  group   ContactGroup? @relation(fields: [groupId], references: [id], onDelete: SetNull)
  items   QueueItem[]

  @@index([sessionId, status])
}

model QueueItem {
  id              String    @id @default(uuid())
  campaignId      String
  position        Int
  recipientJid    String
  recipientName   String?
  /// The final, spintax-resolved text that was actually sent
  renderedMessage String?
  /// PENDING | PROCESSING | SENT | FAILED | CANCELLED
  status          String    @default("PENDING")
  error           String?
  /// WhatsApp message id, used to match delivery/read receipts
  messageId       String?
  deliveredAt     DateTime?
  readAt          DateTime?
  /// Estimated dispatch time computed when the campaign was queued
  scheduledAt     DateTime  @default(now())
  processedAt     DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  campaign BroadcastCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@index([campaignId, status, position])
  @@index([messageId])
}

/// The composer's unsent work, saved as you type so a reload never loses it (one per session).
model Draft {
  sessionId       String    @id
  groupId         String?
  name            String    @default("")
  messageTemplate String    @default("")
  /// JSON MediaInfo of the compressed attachment (see src/lib/types.ts)
  media           String?
  /// Chosen start time when "Schedule" is selected
  scheduledAt     DateTime?
  updatedAt       DateTime  @updatedAt

  session UserSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
}
