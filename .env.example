# Copy to .env:  cp .env.example .env

# SQLite file lives at ./prisma/dev.db (path is relative to prisma/schema.prisma).
# connection_limit=1 serialises writes so SQLite never reports "database is locked".
DATABASE_URL="file:./dev.db?connection_limit=1"

# Server binds to loopback only, so nobody else on your network can reach it.
HOST=127.0.0.1
PORT=3000

# Set to "info" or "debug" to see Baileys protocol logs.
BAILEYS_LOG_LEVEL=silent

# Set to 1 to log the shape (field names only) of incoming contact batches.
# DEBUG_CONTACTS=1
